{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/eaisy-bill/aszf", "destination": "/aszf", "permanent": false },
    { "source": "/eaisy-bill/adatkezelesi-tajekoztato", "destination": "/adatkezelesi-tajekoztato", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!api/|assets/|favicon|og-image|apple-touch-icon|robots.txt|sitemap.xml|eaisy-bill|eaisy-desk|eaisy-boost|eaisy-books|privacy|eaisydesk|aszf|adatkezelesi-tajekoztato).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
